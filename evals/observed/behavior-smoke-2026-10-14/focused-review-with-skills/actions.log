7. Command (cwd workspace):
python3 -B - <<'PY'
import subprocess
from pricing import quote
from display import dollars
from checkout import checkout
baseline = {}
for name in ('pricing.py', 'display.py'):
    source = subprocess.check_output(['git', 'show', f'HEAD:{name}'], text=True)
    exec(compile(source, f'HEAD:{name}', 'exec'), baseline)
cases = [
    ('quote(2, 30, discount_percent=10)', lambda q, d: q(2, 30, discount_percent=10), 54.0),
    ('quote(2, 50, discount_percent=10)', lambda q, d: q(2, 50, discount_percent=10), 90.0),
    ('dollars(90)', lambda q, d: d(90), '$90.00'),
    ('dollars(0)', lambda q, d: d(0), '$0.00'),
    ('checkout()', lambda q, d: d(q(2, 50, discount_percent=10)), '$90.00'),
]
failed = 0
for label, fn, expected in cases:
    before = fn(baseline['quote'], baseline['dollars'])
    after = fn(quote, dollars)
    passed = after == expected
    failed += not passed
    print(f'{label}: expected={expected!r}, HEAD={before!r}, pending={after!r}, {"PASS" if passed else "FAIL"}')
print(f'actual new checkout(): {checkout()!r}')
print(f'{failed} of {len(cases)} pending checks failed; HEAD passed all: {all(fn(baseline["quote"], baseline["dollars"]) == expected for _, fn, expected in cases)}')
raise SystemExit(bool(failed))
